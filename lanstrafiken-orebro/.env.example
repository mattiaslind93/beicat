# Trafiklab API-nycklar — skapa konto och projekt på https://developer.trafiklab.se
# Kopiera till .env (läses av Expo vid start; EXPO_PUBLIC_-prefix krävs).

# ResRobot v2.1 (Route planner + Stop lookup) — reseplanerare, hållplatssök, avgångstavlor
EXPO_PUBLIC_RESROBOT_KEY=din-resrobot-nyckel

# GTFS Regional Realtime — TripUpdates, ServiceAlerts, VehiclePositions för operatören "orebro"
EXPO_PUBLIC_GTFS_RT_KEY=din-gtfs-rt-nyckel

# GTFS Regional Static — daglig statisk tidtabell (används för offline-cache, Fas 1.5)
EXPO_PUBLIC_GTFS_STATIC_KEY=din-gtfs-static-nyckel
